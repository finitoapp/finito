{
  "name": "payky",
  "private": true,
  "version": "26.11.5",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "bun run --parallel --filter @payky/web-app --filter @payky/landing dev",
    "release": "bun run bin/release.ts",
    "build": "bun run build:core && bun run --cwd apps/web-app build",
    "cap": "bun run --cwd apps/native-shell cap",
    "cap:build": "bun run --cwd apps/native-shell cap:build",
    "cap:sync": "bun run --cwd apps/native-shell cap:sync",
    "cap:android:add": "bun run --cwd apps/native-shell cap:android:add",
    "cap:android:sync": "bun run --cwd apps/native-shell cap:android:sync",
    "cap:android:dev": "bun run --cwd apps/native-shell cap:android:dev",
    "cap:android:build": "bun run --cwd apps/native-shell cap:android:build",
    "cap:android:build:debug": "bun run --cwd apps/native-shell cap:android:build:debug",
    "cap:android:build:apk": "bun run --cwd apps/native-shell cap:android:build:apk",
    "cap:android:build:aab": "bun run --cwd apps/native-shell cap:android:build:aab",
    "cap:ios:add": "bun run --cwd apps/native-shell cap:ios:add",
    "cap:ios:sync": "bun run --cwd apps/native-shell cap:ios:sync",
    "cap:ios:open": "bun run --cwd apps/native-shell cap:ios:open",
    "cap:ios:run": "bun run --cwd apps/native-shell cap:ios:run",
    "check:lint": "biome check .",
    "check:ts": "tsc -b",
    "check:tests": "vitest run",
    "check:coverage": "vitest run --coverage",
    "check:decisions": "bun run bin/check-decisions.ts",
    "check": "bun run check:lint && bun run check:ts && bun run check:decisions && bun run check:tests",
    "docs:screenshots": "bun run --cwd apps/web-app docs:screenshots",
    "docs:screenshots:native": "bun run --cwd apps/native-app docs:screenshots",
    "google-play:assets": "bun run --cwd apps/native-app google-play:assets",
    "docs:screenshots:install-browser": "bun run --cwd apps/web-app docs:screenshots:install-browser",
    "docs:videos:capture": "bun run --cwd apps/web-app docs:videos:capture",
    "docs:videos:render": "bun run --cwd apps/web-app docs:videos:render",
    "docs:videos": "bun run --cwd apps/web-app docs:videos",
    "docs:videos:studio": "bun run --cwd apps/web-app docs:videos:studio",
    "format": "biome check --write .",
    "test:watch": "vitest",
    "test:e2e": "bun run --cwd apps/web-app test:e2e",
    "test:e2e:ui": "bun run --cwd apps/web-app test:e2e:ui",
    "test:e2e:preview": "bun run --cwd apps/web-app test:e2e:preview",
    "test:e2e:native:web": "bun run --cwd apps/native-app test:e2e -- --platform web",
    "test:e2e:native:android": "bun run --cwd apps/native-app test:e2e -- --platform android",
    "preview": "bun run --cwd apps/web-app preview",
    "cli": "bun run apps/cli/src/cli.ts",
    "build:core": "bun run --cwd packages/core build",
    "check:api": "bun run bin/check-api.ts",
    "dev:landing": "bun run --cwd apps/landing dev",
    "build:landing": "bun run build:core && bun run --cwd apps/landing build",
    "preview:landing": "bun run --cwd apps/landing preview",
    "dev:native": "bun run build:core && bun run --cwd apps/native-app dev",
    "native:android": "bun run build:core && bun run --cwd apps/native-app android",
    "native:ios": "bun run build:core && bun run --cwd apps/native-app ios",
    "native:web": "bun run build:core && bun run --cwd apps/native-app web",
    "build:native": "bun run build:core && bun run --cwd apps/native-app bundle",
    "build:native:web": "bun run build:core && bun run --cwd apps/native-app build:web",
    "check:native": "bun run --cwd apps/native-app check:ts"
  },
  "dependencies": {
    "@payky/core": "workspace:*",
    "zod": "4.6.7",
    "date-fns": "4.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "@vitest/coverage-v8": "5.0.5",
    "@types/node": "26.6.5",
    "@playwright/test": "1.64.1",
    "@t3-oss/env-core": "0.13.11"
  },
  "trustedDependencies": [
    "@sentry/cli",
    "@swc/core",
    "esbuild",
    "msgpackr-extract",
    "protobufjs"
  ],
  "patchedDependencies": {
    "@expo/metro-config@58.0.14": "patches/@expo%2Fmetro-config@58.0.14.patch",
    "@evolu/common@8.27.2": "patches/@evolu%2Fcommon@8.27.2.patch"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
