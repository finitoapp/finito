{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",
  "files": {
    "includes": [
      "apps/**",
      "packages/**",
      "bin/**",
      "*.json",
      "*.ts",
      "!dist",
      "!.vite",
      "!.ai",
      "!skills",
      "!node_modules",
      "!coverage",
      "!playwright-report",
      "!test-results",
      "!apps/native-shell/android",
      "!apps/native-shell/ios",
      "!apps/web-app/src/routeTree.gen.ts",
      "!apps/native-app/assets/icons",
      "!apps/web-app/remotion/public/generated",
      "!docs/videos",
      "!**/dist",
      "!**/dist-ssr",
      "!**/node_modules",
      "!**/coverage",
      "!**/test-results",
      "!**/playwright-report",
      "!apps/web-app/src/components/ui",
      "!apps/web-app/src/components/reui",
      "!apps/landing/src/components/ui",
      "!**/*.tsbuildinfo"
    ]
  },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "correctness": {
        "noUnusedImports": "error",
        "noUnusedVariables": "error"
      },
      "style": {
        "useImportType": "error"
      },
      "suspicious": {
        "noExplicitAny": "error",
        "noDoubleEquals": {
          "level": "error",
          "options": {
            "ignoreNull": false
          }
        }
      }
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "overrides": [
    {
      "includes": ["apps/native-app/src/**", "apps/native-app/app/**"],
      "linter": {
        "domains": {
          "playwright": "none"
        },
        "rules": {
          "correctness": {
            "noReactNativeRawText": {
              "level": "error",
              "options": {
                "skip": [
                  "AlertDescription",
                  "AlertTitle",
                  "Button",
                  "CardDescription",
                  "CardTitle",
                  "DialogDescription",
                  "DialogTitle",
                  "FieldDescription",
                  "FieldError",
                  "FieldLabel",
                  "FieldSeparator",
                  "SelectItem",
                  "SelectLabel",
                  "SvgText",
                  "TabsTrigger",
                  "TimelineDate",
                  "TimelineTitle",
                  "ToggleGroupItem"
                ]
              }
            }
          }
        }
      }
    }
  ],
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  }
}
