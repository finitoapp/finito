{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/",
      "has": [{ "type": "host", "value": "t\\.finito\\.fit" }],
      "destination": "https://finito.fit",
      "permanent": false
    }
  ],
  "headers": [
    {
      "source": "/t(\\.html)?",
      "headers": [
        { "key": "Content-Security-Policy", "value": "frame-ancestors 'none'" }
      ]
    },
    {
      "source": "/t(\\.html)?",
      "missing": [{ "type": "host", "value": "t\\..*" }],
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "sandbox; default-src 'none'; frame-ancestors 'none'"
        }
      ]
    },
    {
      "source": "/((?!t$|t\\.html$).*)",
      "has": [{ "type": "host", "value": "t\\..*" }],
      "headers": [{ "key": "Content-Security-Policy", "value": "sandbox" }]
    }
  ],
  "rewrites": [
    {
      "source": "/.well-known/lnurlp/donate",
      "destination": "/api/lnurlp/donate"
    },
    {
      "source": "/landing",
      "has": [
        {
          "type": "host",
          "value": "(?:edge\\.payky\\.me|payky-edge(?:-[a-z0-9-]+)?\\.vercel\\.app)"
        }
      ],
      "destination": "https://payky-landing-edge.vercel.app/landing"
    },
    {
      "source": "/landing/:path*",
      "has": [
        {
          "type": "host",
          "value": "(?:edge\\.payky\\.me|payky-edge(?:-[a-z0-9-]+)?\\.vercel\\.app)"
        }
      ],
      "destination": "https://payky-landing-edge.vercel.app/landing/:path*"
    },
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "(?:edge\\.payky\\.me|payky-edge(?:-[a-z0-9-]+)?\\.vercel\\.app)"
        }
      ],
      "destination": "https://payky-landing-edge.vercel.app/sitemap.xml"
    },
    {
      "source": "/landing",
      "destination": "https://payky-landing.vercel.app/landing"
    },
    {
      "source": "/landing/:path*",
      "destination": "https://payky-landing.vercel.app/landing/:path*"
    },
    {
      "source": "/sitemap.xml",
      "destination": "https://payky-landing.vercel.app/sitemap.xml"
    },
    {
      "source": "/t",
      "has": [{ "type": "host", "value": "t\\..*" }],
      "destination": "/t.html"
    },
    {
      "source": "/((?!.*\\.).*)",
      "destination": "/index.html"
    }
  ],
  "installCommand": "cd ../.. && bun install --frozen-lockfile",
  "buildCommand": "cd ../.. && bun run build",
  "outputDirectory": "dist",
  "framework": "vite"
}
