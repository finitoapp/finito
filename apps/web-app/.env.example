# Enables client-side Sentry error reporting when set. Users still need to
# turn error reporting on in Settings > Privacy; leaving this unset disables
# Sentry entirely regardless of that setting.
VITE_SENTRY_DSN=

# Build-time only (do not prefix with VITE_): used by @sentry/vite-plugin to
# upload source maps to Sentry during production builds. Leave unset to skip
# the upload step, e.g. for local builds.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Origin of the /api serverless functions. Leave unset on a deployment: the web
# then calls its own origin and the native app payky.me. `bun run dev` serves no
# /api, so set it locally (e.g. https://payky.me) to reach one.
VITE_PAYKY_API_BASE_URL=

# EET 2.0 production SOAP endpoint. Leave unset to offer only the playground.
VITE_PAYKY_EET_PRODUCTION_URL=

# Origin of the table self-pay guest page, which stickers link to. Vercel
# serves /t only on a host that starts with t. Defaults to https://t.payky.me.
VITE_PAYKY_SELF_PAY_ORIGIN=

# Comma-separated wss: relays the account's self-pay relay list starts from.
VITE_PAYKY_SELF_PAY_RELAYS=

# Server-only (do not prefix with VITE_): the support chat's team, served by
# /api/support-team so it changes with a deploy, no app release needed.
# Comma-separated npubs; when the team changes, append its line-up until then
# to the former teams (teams separated by ";", oldest first) so the app keeps
# showing that conversation. Every support member lists one of the relays as
# a DM relay in Amethyst. The indexer relays are only read, for the team's
# names and the account's DM relay list.
PAYKY_SUPPORT_NPUBS=npub1ysdhhw8wx4ew4490mrfpd2gyv3w08rqudqp5pjasgn2kxduahuhstrqnll,npub1lhxycw3zsyyhz47khqcsw65f4m94p0fuvrs6lxvcqrwv5w0xxs8saaejq0
PAYKY_SUPPORT_FORMER_TEAMS=npub1ysdhhw8wx4ew4490mrfpd2gyv3w08rqudqp5pjasgn2kxduahuhstrqnll
PAYKY_SUPPORT_RELAYS=wss://relay.damus.io,wss://nos.lol,wss://relay.0xchat.com,wss://nostr.linky.fit
PAYKY_SUPPORT_INDEXER_RELAYS=wss://purplepag.es,wss://profiles.nostr1.com
