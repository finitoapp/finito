{
  "name": "@payky/web-app",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "cap:build": "PAYKY_CAPACITOR_BUILD=1 vite build --outDir dist-native",
    "docs:screenshots": "bun run scripts/generate-doc-screenshots.ts",
    "docs:screenshots:install-browser": "bunx playwright install chromium",
    "docs:videos:capture": "bun run scripts/generate-doc-videos.ts",
    "docs:videos:render": "bun run scripts/render-doc-videos.ts",
    "docs:videos": "bun run docs:videos:capture && bun run docs:videos:render",
    "docs:videos:studio": "remotion studio",
    "test:e2e": "node --conditions=development ./node_modules/@playwright/test/cli.js test",
    "test:e2e:ui": "node --conditions=development ./node_modules/@playwright/test/cli.js test --ui",
    "test:e2e:preview": "PAYKY_E2E_BUILD=1 VITE_PAYKY_EET_PRODUCTION_URL=https://eet-production.invalid/eet/services/EETServiceSOAP/v4 bun run build && bun run --cwd ../landing build && PAYKY_E2E_SERVER=preview node --conditions=development ./node_modules/@playwright/test/cli.js test",
    "preview": "vite preview",
    "check:ts": "tsc -b",
    "check:tests": "vitest run",
    "test:watch": "vitest",
    "check:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@buildonspark/spark-sdk": "0.14.0",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/share": "8.0.3",
    "@dedalik/use-react": "1.1.2",
    "@evolu/common": "8.26.0",
    "@evolu/sqlite-wasm": "3.54.1-build3",
    "@evolu/web": "3.7.0",
    "@payky/core": "workspace:*",
    "@sentry/react": "11.8.0",
    "@sentry/vite-plugin": "11.8.0",
    "@t3-oss/env-core": "0.13.11",
    "@tailwindcss/vite": "4.3.3",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-router": "1.170.44",
    "@yudiel/react-qr-scanner": "2.6.0",
    "ai": "7.0.142",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cn": "0.4.0",
    "date-fns": "4.4.0",
    "fflate": "0.8.3",
    "input-otp": "1.5.0",
    "jotai": "3.0.1",
    "lucide-react": "1.57.0",
    "motion": "14.3.0",
    "nostr-tools": "2.25.2",
    "qrcode.react": "4.2.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "ua-parser-js": "2.0.10",
    "zod": "4.6.7",
    "barcode-detector": "3.2.0",
    "workbox-window": "7.4.1",
    "@payky/app-shared": "workspace:*",
    "@payky/web-shared": "workspace:*"
  },
  "devDependencies": {
    "@payky/doc-mockups": "workspace:*",
    "@playwright/test": "1.64.1",
    "@remotion/bundler": "4.0.535",
    "@remotion/cli": "4.0.535",
    "@remotion/renderer": "4.0.535",
    "@tanstack/router-plugin": "1.168.46",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-basic-ssl": "2.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "remotion": "4.0.535",
    "shadcn": "4.21.5",
    "typescript": "6.0.3",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.5"
  }
}
