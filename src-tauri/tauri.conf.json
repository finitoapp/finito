{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "finito",
  "version": "0.1.0",
  "identifier": "com.finito.dev",
  "build": {
    "frontendDist": "../out",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "bun dev",
    "beforeBuildCommand": "bun run build"
  },
  "app": {
    "windows": [
      {
				"label": "mainPos",
        "title": "Finito POS",
				"url": "/admin",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      },
			{
				"label": "main",
				"title": "Finito",
				"url": "/",
				"width": 800,
				"height": 600,
				"resizable": true,
				"fullscreen": false
			}
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "appimage",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
